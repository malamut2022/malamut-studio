rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Реакции: каждый зритель ставит одну реакцию на работу и может её сменить или убрать
    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['w', 'u', 'r', 'at'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.w is string
        && request.resource.data.w.size() > 0 && request.resource.data.w.size() < 64
        && request.resource.data.r in ['heart', 'fire', 'poop']
        && voteId == request.resource.data.w + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.u == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
