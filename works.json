 {
  "id": "ya-k-tebe-nikogda",
  "title": "Я к тебе никогда не вернусь",
  "desc": "Стихи — Анна Ахматова (в переработке) · Музыка — студия MALAMUT",
  "added": "2026-10-29T06:34:00.000Z",
  "kind": "audio",
  "file": "media/ya-k-tebe-nikogda.mp3",
  "poster": "media/ya-k-tebe-nikogda.jpg",
  "duration": "1:49",
  "lyrics": [
   {
    "t": 6.5,
    "x": "А ты думал — я тоже такая,"
   },
   {
    "t": 10.4,
    "x": "Что легко можно взять — и забыть,"
   },
   {
    "t": 13.9,
    "x": "Что я брошусь, моля и рыдая,"
   },
   {
    "t": 17.8,
    "x": "Под копыта, чтоб сердце смыть."
   },
   {
    "t": 21.0,
    "x": "Ты, наверное, думал устало,"
   },
   {
    "t": 24.9,
    "x": "Что сломаюсь я в первый же час,"
   },
   {
    "t": 28.4,
    "x": "Что под ветром мне станет так мало"
   },
   {
    "t": 32.3,
    "x": "Собственных, обжигающих фраз."
   },
   {
    "t": 39.3,
    "x": "Или стану просить у знахарок"
   },
   {
    "t": 43.2,
    "x": "В наговорной воде корешок,"
   },
   {
    "t": 46.7,
    "x": "Чтобы высушить память и ярость,"
   },
   {
    "t": 50.6,
    "x": "Чтоб прислать тебе странный венок."
   },
   {
    "t": 54.1,
    "x": "Может, верить ты стал в эти сказки,"
   },
   {
    "t": 58.0,
    "x": "В тайный шепот и в тряпочный знак,"
   },
   {
    "t": 61.5,
    "x": "Что пришлю тебе, будто бы в ласке,"
   },
   {
    "t": 65.4,
    "x": "Мой заветный душистый платок просто так."
   },
   {
    "t": 73.4,
    "x": "Будь же проклят — ни стоном, ни взглядом"
   },
   {
    "t": 77.3,
    "x": "Окаянной души не коснусь,"
   },
   {
    "t": 80.8,
    "x": "Но клянусь тебе ангельским садом,"
   },
   {
    "t": 84.7,
    "x": "Чудотворной иконой клянусь."
   },
   {
    "t": 88.2,
    "x": "И ночей наших пламенным чадом,"
   },
   {
    "t": 92.1,
    "x": "И пожаром не сбывшихся чувств —"
   },
   {
    "t": 95.6,
    "x": "Я к тебе, ни при жизни, ни рядом,"
   },
   {
    "t": 99.5,
    "x": "Никогда, никогда не вернусь."
   }
  ],
  "lyricsApprox": true
 },
 {
  "id": "primavera",
  "title": "Primavera",
  "desc": "Стихи — Афанасий Фет, «Я пришёл к тебе с приветом…» (перевод на итальянский, в переработке) · Музыка — студия MALAMUT",
  "added": "2026-10-29T06:35:00.000Z",
  "kind": "audio",
  "file": "media/primavera.mp3",
  "poster": "media/primavera.jpg",
  "duration": "2:58",
  "lyrics": [
   {
    "t": 10.7,
    "x": "Sono qui con il mattino,"
   },
   {
    "t": 14.3,
    "x": "con il sole sopra il cuore."
   },
   {
    "t": 18.2,
    "x": "Ogni foglia prende vita,"
   },
   {
    "t": 21.7,
    "x": "si risveglia nel suo splendore."
   },
   {
    "t": 26.0,
    "x": "Ogni ramo canta piano,"
   },
   {
    "t": 29.5,
    "x": "ogni cielo sembra vero,"
   },
   {
    "t": 33.1,
    "x": "e la primavera danza"
   },
   {
    "t": 36.3,
    "x": "come un sogno leggero."
   },
   {
    "t": 43.1,
    "x": "Ogni respiro parla di te,"
   },
   {
    "t": 46.6,
    "x": "come il vento parla al mare."
   },
   {
    "t": 54.0,
    "x": "Vengo ancora da te,"
   },
   {
    "t": 56.9,
    "x": "con la stessa emozione."
   },
   {
    "t": 60.5,
    "x": "Ogni giorno il mio cuore"
   },
   {
    "t": 64.7,
    "x": "cerca la tua direzione."
   },
   {
    "t": 68.6,
    "x": "Non so ancora quale canto"
   },
   {
    "t": 72.5,
    "x": "nascerà dentro di me,"
   },
   {
    "t": 75.1,
    "x": "ma già sento questa musica"
   },
