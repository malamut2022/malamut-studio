 {
  "id": "v-otpusk-hochu",
  "title": "В отпуск хочу",
  "desc": "",
  "added": "2026-10-28T18:58:00.000Z",
  "kind": "audio",
  "file": "media/v-otpusk-hochu.m4a",
  "poster": "media/v-otpusk-hochu.jpg",
  "duration": "3:22",
  "lyrics": [
   {
    "t": 0.0,
    "x": "Снова утро, город спит,"
   },
   {
    "t": 10.5,
    "x": "Кофе стынет, дождь шумит."
   },
   {
    "t": 14.0,
    "x": "День расписан по часам,"
   },
   {
    "t": 17.5,
    "x": "Но душа стремится к волнам."
   },
   {
    "t": 20.5,
    "x": "Я устал считать дела,"
   },
   {
    "t": 22.5,
    "x": "Мне свобода так нужна."
   },
   {
    "t": 26.5,
    "x": "Где прибой встречает свет,"
   },
   {
    "t": 31.5,
    "x": "Там меня тревоги нет."
   },
   {
    "t": 35.0,
    "x": "Слышу море вновь и вновь,"
   },
   {
    "t": 38.5,
    "x": "Оно зовёт меня с собой."
   },
   {
    "t": 45.0,
    "x": "Отпуск! Я уже лечу,"
   },
   {
    "t": 52.0,
    "x": "Все заботы отпущу."
   },
   {
    "t": 55.0,
    "x": "Солнце, ветер и прибой —"
   },
   {
    "t": 60.0,
    "x": "Наконец-то я живой."
   },
   {
    "t": 62.5,
    "x": "Отпуск! Небо надо мной,"
   },
   {
    "t": 66.5,
    "x": "Горизонт такой большой."
   },
   {
    "t": 69.5,
    "x": "Без часов и суеты,"
   },
   {
    "t": 73.0,
    "x": "Только море, только ты."
   },
   {
    "t": 76.5,
    "x": "Босиком по берегу,"
   },
   {
    "t": 77.5,
    "x": "Вслед бегущему песку."
   },
   {
    "t": 90.5,
    "x": "Каждый вечер — как мечта,"
   },
   {
    "t": 94.0,
    "x": "Сердце снова бьётся в такт."
   },
   {
    "t": 97.5,
    "x": "Нет будильников с утра,"
   },
   {
    "t": 101.0,
    "x": "Нет привычного «пора»."
   },
   {
    "t": 105.5,
    "x": "Только чайки над волной"
   },
   {
    "t": 108.0,
    "x": "И свобода за спиной."
   },
   {
    "t": 111.5,
    "x": "Пусть весь мир немного ждёт,"
   },
   {
    "t": 114.0,
    "x": "Жизнь обратно позовёт."
   },
   {
    "t": 117.0,
    "x": "Но сейчас я здесь живу,"
   },
   {
    "t": 121.5,
    "x": "Каждым вдохом дорожу."
   },
   {
    "t": 126.5,
    "x": "Отпуск! Я уже лечу,"
   },
   {
    "t": 132.0,
    "x": "Все заботы отпущу."
   },
   {
    "t": 135.5,
    "x": "Солнце, ветер и прибой —"
   },
   {
    "t": 140.0,
    "x": "Наконец-то я живой."
   },
   {
    "t": 142.5,
    "x": "Отпуск! Не кончайся, стой,"
   },
   {
    "t": 145.5,
    "x": "Оставайся ты со мной."
   },
   {
    "t": 150.0,
    "x": "Даже если путь домой —"
   },
   {
    "t": 154.0,
    "x": "Море будет жить со мной."
   },
   {
    "t": 163.0,
    "x": "Отпуск…"
   },
   {
    "t": 182.0,
    "x": "Я уже лечу…"
   }
  ],
  "order": 1
 },
