 {
  "id": "mein-engel",
  "title": "Mein Engel",
  "desc": "Стихи — Александр Пушкин, «Признание» (перевод на немецкий, в переработке) · Музыка — студия MALAMUT",
  "added": "2026-10-29T06:32:00.000Z",
  "kind": "audio",
  "file": "media/mein-engel.mp3",
  "poster": "media/mein-engel.jpg",
  "duration": "4:40",
  "lyrics": [
   {
    "t": 12.0,
    "x": "Ich liebe dich..."
   },
   {
    "t": 16.4,
    "x": "Auch wenn es Schmerz bedeutet."
   },
   {
    "t": 23.4,
    "x": "Auch wenn mein Herz"
   },
   {
    "t": 28.4,
    "x": "An dieser Sehnsucht leidet."
   },
   {
    "t": 35.5,
    "x": "Ich weiß genau,"
   },
   {
    "t": 40.5,
    "x": "Es passt nicht mehr zu mir."
   },
   {
    "t": 45.6,
    "x": "Doch jede Nacht"
   },
   {
    "t": 49.3,
    "x": "Verlier ich mich in dir."
   },
   {
    "t": 58.5,
    "x": "Ohne dich"
   },
   {
    "t": 62.2,
    "x": "Ist jede Stunde leer."
   },
   {
    "t": 67.9,
    "x": "Mit dir"
   },
   {
    "t": 71.6,
    "x": "Will ich nur noch mehr."
   },
   {
    "t": 79.4,
    "x": "Mein Engel,"
   },
   {
    "t": 83.1,
    "x": "Wie sehr ich dich liebe!"
   },
   {
    "t": 89.5,
    "x": "Jeder Blick"
   },
   {
    "t": 93.2,
    "x": "Lässt meine Seele fliegen."
   },
   {
    "t": 100.2,
    "x": "Ein Lächeln von dir"
   },
   {
    "t": 104.6,
    "x": "Vertreibt jede Nacht."
   },
   {
    "t": 109.6,
    "x": "Nur deine Nähe"
   },
   {
    "t": 114.0,
    "x": "Hat mein Herz entfacht."
   },
   {
    "t": 122.5,
    "x": "Wenn ich"
   },
   {
    "t": 126.2,
    "x": "Deinen leisen Schritt hör,"
   },
   {
    "t": 131.9,
    "x": "Deine Stimme,"
   },
   {
    "t": 136.3,
    "x": "Sanft wie ein Gebet."
   },
   {
    "t": 142.0,
    "x": "Dann schweigt"
   },
   {
    "t": 145.7,
    "x": "Die ganze Welt in mir."
   },
   {
    "t": 151.4,
    "x": "Und jeder Traum"
   },
   {
    "t": 155.7,
    "x": "Beginnt nur noch mit dir."
   },
   {
    "t": 164.3,
    "x": "Vielleicht"
   },
   {
    "t": 168.0,
    "x": "Verdien ich deine Liebe nicht."
   },
   {
    "t": 176.4,
    "x": "Vielleicht"
   },
   {
    "t": 180.1,
    "x": "Bleibt Hoffnung nur ein Licht."
   },
   {
    "t": 186.4,
    "x": "Doch schau mich an,"
   },
   {
    "t": 190.8,
    "x": "Nur ein einziges Mal."
   },
   {
    "t": 197.2,
    "x": "Selbst eine Lüge"
   },
   {
    "t": 201.5,
    "x": "Wäre mir egal."
   },
   {
    "t": 208.7,
    "x": "Mein Engel,"
   },
   {
    "t": 212.4,
    "x": "Wie sehr ich dich liebe!"
   },
   {
    "t": 218.8,
    "x": "Jeder Blick"
   },
   {
    "t": 222.5,
    "x": "Lässt meine Seele fliegen."
   },
   {
    "t": 229.5,
    "x": "Bleib einen Augenblick."
   },
   {
    "t": 236.6,
    "x": "Sag kein Wort."
   },
   {
    "t": 240.3,
    "x": "Ich glaub an Träume..."
   },
   {
    "t": 245.3,
    "x": "Und trag sie mit dir fort."
   },
   {
    "t": 254.5,
    "x": "Ich liebe dich..."
   },
   {
    "t": 258.9,
    "x": "Auch wenn ich daran zerbreche..."
   },
   {
    "t": 265.9,
    "x": "Ich liebe dich..."
   },
   {
    "t": 270.3,
    "x": "Für immer."
   }
  ],
  "lyricsApprox": true,
